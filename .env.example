# Edge Core POS Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database Connection (PostgreSQL 16)
# If PostgreSQL is not reachable, the system seamlessly falls back to embedded PGlite (PostgreSQL 16 WASM)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/restaurant_pos

# Redis Configuration (Falls back to In-Memory Event Bus & Cache if not reachable)
REDIS_URL=redis://localhost:6379

# Security & Authorization
MANAGER_PIN=1234

# Hardware ESC/POS Network Thermal Printer (Port 9100 Raw TCP)
PRINTER_HOST=127.0.0.1
PRINTER_PORT=9100
KITCHEN_PRINTER_HOST=127.0.0.1
KITCHEN_PRINTER_PORT=9100
